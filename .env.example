# Copy to .env and adjust. Never commit the real .env.
POSTGRES_USER=data-stream_pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=data-stream_pipeline

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Host ports for LOCAL development only (loopback). Leave these out on a server / Coolify: Docker then picks free random ports
# and nothing can clash (port 8000 is Coolify's own dashboard). See `docker compose port web 80`.
WEB_PORT=8080
API_PORT=8000
DB_PORT=5434

LOG_LEVEL=INFO
